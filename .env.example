# Database
DATABASE_URL=postgresql://user:password@localhost/omrmeroj

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_DAYS=15
ALGORITHM=HS256

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_API_BASE=https://api.telegram.org

# Verification Code
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_RESEND_COOLDOWN_SECONDS=60

# Supabase (agar ishlatilsa)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_BUCKET=question-images

# Telefon validatsiyasi
PHONE_PATTERN=^\+998[0-9]{9}$
PHONE_COUNTRY_CODE=998
PHONE_MIN_LENGTH=9
PHONE_MAX_LENGTH=9
PHONE_ALLOWED_OPERATORS=90,91,93,94,95,97,98,99,33,88,77,55,50,20,70

# Development mode
DEV_MODE=False
OUTPUT_DIR=./generated_files
UPLOAD_DIR=./uploads